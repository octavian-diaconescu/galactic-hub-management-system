<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.octavian.galactic.ui.controller.HazardScanController"
      spacing="16">
    <padding>
        <Insets top="20" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Hazard Scan" styleClass="section-heading"/>
    <Label text="Scans all docked ships for hazardous cargo." styleClass="info-label, secondary-text"/>
    <VBox spacing="10" styleClass="card">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>
        <Label text="Scanner" styleClass="card-title"/>
        <VBox fx:id="warningsBox" spacing="8"/>
        <Button fx:id="scanBtn" text="Scan All Docked Ships" styleClass="btn-primary" maxWidth="Infinity"
                onAction="#onScan"/>
        <TextArea fx:id="results" editable="false" prefRowCount="14" styleClass="log-area"/>
    </VBox>
</VBox>
