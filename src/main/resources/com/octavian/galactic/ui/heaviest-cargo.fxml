<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.octavian.galactic.ui.controller.HeaviestCargoController"
      spacing="16">
    <padding>
        <Insets top="20" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Find Heaviest Cargo Ship" styleClass="section-heading"/>
    <Label text="Searches for the cargo ship carrying the most weight." styleClass="info-label, secondary-text"/>
    <VBox spacing="10" styleClass="card">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>
        <Label text="Search Scope" styleClass="card-title"/>
        <RadioButton fx:id="dockedScope" text="Among docked ships" styleClass="form-radio"/>
        <RadioButton fx:id="allTimeScope" text="All time (registered)" styleClass="form-radio"/>
        <Separator/>
        <Button text="Find Heaviest" styleClass="btn-primary" maxWidth="Infinity" onAction="#onFind"/>
        <Label fx:id="result" wrapText="true" styleClass="feedback-idle"/>
    </VBox>
</VBox>
