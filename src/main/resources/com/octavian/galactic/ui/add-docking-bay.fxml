<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.octavian.galactic.ui.controller.AddDockingBayController">
    <padding>
        <Insets bottom="24" left="24" right="24" top="20" />
    </padding>
    <Label styleClass="section-heading" text="Add Docking Bay" />
    <Label styleClass="info-label, secondary-text" text="Creates a new empty bay and saves it to the database. Bay number is assigned by the hub." wrapText="true" />
    <VBox spacing="10" styleClass="card">
        <padding>
            <Insets bottom="16" left="16" right="16" top="16" />
        </padding>
        <Label styleClass="card-title" text="New bay" />
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label maxWidth="140" minWidth="140" styleClass="form-label" text="Name" />
            <TextField fx:id="nameField" promptText="Bay display name" styleClass="form-input" HBox.hgrow="ALWAYS" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label maxWidth="140" minWidth="140" styleClass="form-label" text="Max ship size" />
            <ComboBox fx:id="sizePicker" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
        </HBox>
        <Button maxWidth="Infinity" onAction="#onCreate" styleClass="btn-primary" text="Create bay" />
        <Label fx:id="feedback" styleClass="feedback-idle" wrapText="true" />
    </VBox>
</VBox>
